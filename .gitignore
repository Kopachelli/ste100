# Local working inputs. Never committed.
#
# .input/.official/ holds ASD-STE100 Issue 9, the change form, and the STEMG
# white paper. ASD-STE100 is free to obtain but not free to redistribute:
# Issue 9, page 2, permits reproduction only with the written authority of an
# officer of ASD, or by eight listed categories of organization. This project
# is in none of them. Get your own copy from https://www.asd-ste100.org/
#
# .input/.skill/ holds a vendored copy of a third-party repository. It belongs
# to its own author, not to this repository.
.input/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Editors and OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Filled change forms.
#
# The ASD change form is part of ASD-STE100 (Issue 9, page vi). Publishing a
# filled copy would publish part of the standard, which the copyright notice
# does not permit and which NOTICE.md says this repository does not do.
#
# The proposal content is in proposal.md and form-fields.txt. Regenerate the
# form locally from your own copy of the blank form:
#     python .change-proposals/fill_form.py CHANGE-FORM.docx form-fields.txt
.change-proposals/**/*.docx
.change-proposals/**/*.pdf

# Claude Code local overrides
.claude/settings.local.json
